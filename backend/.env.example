# PostgreSQL connection string
# Local Docker: postgresql://medicare:medicare123@localhost:5432/medicare_db
# Neon/Supabase: paste your hosted PostgreSQL URL here
DATABASE_URL="postgresql://medicare:medicare123@localhost:5432/medicare_db"

# Server
PORT=5000
NODE_ENV=development

# JWT secrets — change these in production!
JWT_ACCESS_SECRET="change-this-access-secret-in-production"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
